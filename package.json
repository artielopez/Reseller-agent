    "format": "prettier --write .",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0 <23"
