# Start with the free local demo. Explicit true always disables cloud and paid AI calls.
NEXT_PUBLIC_DEMO_MODE=true

# Live mode: set DEMO_MODE=false and fill BOTH public Supabase values.
# Use a public publishable key (sb_publishable_...) from Supabase API settings.
# The existing ANON_KEY variable name also accepts the legacy public anon JWT.
# These two NEXT_PUBLIC values are intentionally browser-visible; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix this with NEXT_PUBLIC_ or commit .env.local.
# Optional: without a key, authenticated users get clearly labeled template drafts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
