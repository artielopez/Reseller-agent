# Parent process only. Copy to .env.worker; chmod 600 .env.worker.
# Never place these values in OpenClaw config or commit .env.worker.
RESELLER_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key or legacy anon key only; never secret/service_role.
RESELLER_SUPABASE_PUBLIC_KEY=
# One-time draft-only enrollment key from the signed-in Inbox controls.
RESELLER_WORKER_TOKEN=
# Default legacy route: paid API requests. Explicitly choose subscription for
# the supervised synthetic trial below; there is no fallback between routes.
RESELLER_DRAFT_PROVIDER=api
OPENAI_API_KEY=
# Explicit model with Responses structured output and reasoning effort none support.
OPENAI_MODEL=
# Supervised subscription trial only (worker:once; watch is rejected).
# Remove OPENAI_API_KEY, CODEX_API_KEY and OPENAI_MODEL from the environment.
# RESELLER_DRAFT_PROVIDER=subscription
# RESELLER_SUBSCRIPTION_PROFILE=YOUR_EXISTING_OPENAI_OAUTH_PROFILE_ID
# Operator verifies included allowance, zero credits, auto-reload off, then
# sets a UTC ISO expiry no more than one hour ahead. Never renew automatically.
# This is an operator attestation, not an enforced provider spending cap.
# RESELLER_SUBSCRIPTION_VERIFIED_UNTIL=
# SHA-256 of the exact JSON-serialized DraftInput for a synthetic test question.
# Unmatched payloads are rejected before the broker launches inference.
# RESELLER_SUBSCRIPTION_INPUT_SHA256=
# Optional Mac paths. Defaults shown; parent Node is 22, OpenClaw Node is 24.
# RESELLER_WORKER_STATE_DIR=/Users/YOUR_USER/.reseller-agent-worker
# RESELLER_OPENCLAW_PATH=/opt/homebrew/lib/node_modules/openclaw
# RESELLER_OPENCLAW_NODE=/opt/homebrew/bin/node
