{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": ".worker-build",
    "noEmit": false,
    "incremental": false,
    "plugins": [],
    "jsx": "react-jsx"
  },
  "include": ["src/worker/main.ts"],
  "exclude": ["node_modules", ".sites", ".next"]
}
